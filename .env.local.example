# Runtime environment; independent from the hosting provider.
APP_ENV=local
# Canonical origin used for links and redirects.
PUBLIC_BASE_URL=http://localhost:3000
# Product name safe to expose in browser bundles.
NEXT_PUBLIC_APP_NAME=Adorbitals
# Local PostgreSQL runtime URL. Replace credentials locally; never commit real values.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app
# Optional privileged direct migration URL. Blank falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Local PostgreSQL TLS policy.
DATABASE_SSL_MODE=disable
# Maximum runtime connections per application process.
DATABASE_POOL_MAX=10
# Maximum milliseconds to acquire a PostgreSQL connection.
DATABASE_ACQUIRE_TIMEOUT_MS=5000
# Milliseconds before an idle pooled connection is closed.
DATABASE_IDLE_TIMEOUT_MS=30000
# Maximum PostgreSQL statement execution time in milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Cloudflare R2 S3 API HTTPS endpoint. Replace the account identifier.
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# S3 signing region configured for the R2 account.
R2_REGION=auto
# Server-only local-development credentials; never commit real values.
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
# Separate local private drafts/quarantine from public approved derivatives.
R2_PRIVATE_BUCKET=ador-local-drafts
R2_PUBLIC_BUCKET=ador-local-public
# Inngest application identifier shown in the Inngest dashboard.
INNGEST_APP_ID=adorbitals-local
# Use a local Inngest development server instead of Inngest Cloud: true or false. Must be false when APP_ENV is preview or production, because development mode skips signature verification.
INNGEST_DEV=true
# Inngest API base URL. Blank uses Inngest Cloud; a local development server uses http://localhost:8288.
INNGEST_BASE_URL=http://localhost:8288
# Server-only key used to publish workflow events. Replace through the runtime secret store.
INNGEST_EVENT_KEY=replace-me
# Server-only key that verifies requests from Inngest. Replace through the runtime secret store.
INNGEST_SIGNING_KEY=replace-me
# Sliding idle lifetime for authenticated platform sessions in milliseconds.
AUTH_SESSION_IDLE_TIMEOUT_MS=86400000
# Absolute lifetime for authenticated platform sessions in milliseconds.
AUTH_SESSION_ABSOLUTE_TIMEOUT_MS=604800000
# Maximum passkey registration ceremony lifetime in milliseconds.
PASSKEY_CHALLENGE_TIMEOUT_MS=300000
# Maximum authentication age allowed for passkey changes in milliseconds.
PASSKEY_RECENT_AUTH_WINDOW_MS=600000
# JSON object keyed by the id of a game played at an address of its own (none is registered today; a game the platform plays itself must not be named): {"my-game":{"url":"https://play.example.com","basePath":"","returnUrl":"https://example.com/games/my-game","network":"bip122:00000008819873e925422c1ff0f99f7c"}}. url is a host with no path; basePath is where the game lives under it (blank = the whole host); returnUrl must be on PUBLIC_BASE_URL. HTTPS is required in preview and production. Blank is the normal case.
GAME_LAUNCHES=
# Content Security Policy mode: report-only (violations are reported, nothing is blocked) or enforce. Blank means report-only.
SECURITY_CSP_MODE=
# How many reverse proxies in front of the app set X-Forwarded-For (0 to 5). Blank means 1. The client address is read that many hops from the end. Direct local runs have none.
TRUSTED_PROXY_HOPS=0
# The test network the beta runs on: signet or testnet4; blank means signet. The wallet network, games' chain, collections' target chain and the rewards chain follow it, and the node address must serve it (ADR-019).
BETA_NETWORK=
# Address of the JSON-RPC node (Bitcoin and Alkanes methods) the games' rewards contracts are reached through; blank means no rewards chain, and claims and staff administration answer not available. It may carry a key, so it is secret.
REWARDS_CHAIN_RPC_URL=
# The key a gateway node asks for, sent in the header named by REWARDS_CHAIN_RPC_API_KEY_HEADER; blank when the node needs none. Set both or neither.
REWARDS_CHAIN_RPC_API_KEY=
# Name of the HTTP header that carries REWARDS_CHAIN_RPC_API_KEY (the node's documentation says which); blank when the node needs none.
REWARDS_CHAIN_RPC_API_KEY_HEADER=
# Milliseconds before a call to the rewards chain node gives up; blank means 15000.
REWARDS_CHAIN_RPC_TIMEOUT_MS=
# The most, in satoshis, a player's claim or a staff step may pay in fee. Required when REWARDS_CHAIN_RPC_URL is set.
REWARDS_MAX_FEE_SATS=
# Directory holding the built game-rewards.wasm and milestone-collectible.wasm (contracts/templates/build.sh). Blank means staff cannot publish templates or create games.
REWARDS_TEMPLATES_DIR=
# How the platform sends mail: smtp (any SMTP server; Resend, Postmark and ZeptoMail all offer one) or capture (writes each message to MAIL_CAPTURE_DIRECTORY and delivers nothing; refused in preview and production). Blank means no mail, and sign-in by email is not offered.
MAIL_TRANSPORT=
# The sender address on every message (on a domain the provider has verified: SPF and DKIM). Required when MAIL_TRANSPORT is set.
MAIL_FROM_ADDRESS=
# The SMTP server's host name. Required for smtp. Take it from the provider's SMTP documentation.
MAIL_SMTP_HOST=
# The SMTP server's port (465 for tls, 587 for starttls are the usual ones). Required for smtp.
MAIL_SMTP_PORT=
# tls (encrypted from the start), starttls (upgrades, and refuses to send if the server cannot) or none (plain; for a stand-in server on a developer's machine, refused in preview and production). Required for smtp.
MAIL_SMTP_ENCRYPTION=
# The SMTP login name the provider gives. Required for smtp.
MAIL_SMTP_USER=
# The SMTP password the provider gives (often an API key or token). Required for smtp.
MAIL_SMTP_PASSWORD=
# Milliseconds before a wait on the mail server gives up; blank means 10000.
MAIL_TIMEOUT_MS=
# Directory the capture transport writes messages to (read them with pnpm mailbox). Required for capture.
MAIL_CAPTURE_DIRECTORY=
# Another explorer to take fee levels from, answering like mempool.space (its address up to the network, e.g. https://example.org/signet), for when the network's default explorer cannot be reached from here. Blank uses the default. Not together with REWARDS_FEE_RATE_SAT_VB.
REWARDS_FEE_API_URL=
# A fee rate in sat/vB used for every step instead of asking an explorer (up to 1000; the step's total fee is still held to REWARDS_MAX_FEE_SATS). It is a fixed number you keep honest, not a live one. Blank asks the explorer. Not together with REWARDS_FEE_API_URL.
REWARDS_FEE_RATE_SAT_VB=
