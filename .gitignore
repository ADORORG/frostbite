# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files (documented `.example` files remain tracked)
.env
.env.*
!.env.example
!.env.*.example
!apps/web/.env.example

# The local stack's kept passwords (its data lives in Docker volumes)
.stack-data/

# Testing
coverage
playwright-report
test-results

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
.next-qualification/
out/
build
dist
dist
target/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Built from /games by scripts/build-games.ts
/apps/web/public/play/
# Rendered scene videos (pnpm scenes:render); generated, never hand-edited
/apps/web/public/scenes/
/tooling/game-tools/.tmp-*
/tooling/game-tools/.pin-*

# Local regtest state and built indexer (tooling/regtest)
tooling/regtest/.regtest/
tooling/regtest/.signet/

# pnpm ci:local: logs and the browsers it installs
.ci-local/
