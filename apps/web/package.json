{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node --experimental-strip-types scripts/build-games.ts",
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types scripts/build-games.ts",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node --experimental-strip-types scripts/start-standalone.ts",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts integration",
    "test:coverage": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts coverage",
    "test:e2e": "pnpm --filter @repo/e2e test:e2e"
  },
  "dependencies": {
    "@frostbite/auth": "workspace:*",
    "@frostbite/authorization": "workspace:*",
    "@frostbite/chain": "workspace:*",
    "@frostbite/database": "workspace:*",
    "@frostbite/feature-accounts": "workspace:*",
    "@frostbite/feature-chain-status": "workspace:*",
    "@frostbite/feature-collection-review": "workspace:*",
    "@frostbite/feature-collection-studio": "workspace:*",
    "@frostbite/feature-creator-admission": "workspace:*",
    "@frostbite/feature-game-admin": "workspace:*",
    "@frostbite/feature-games": "workspace:*",
    "@frostbite/feature-platform-shell": "workspace:*",
    "@frostbite/feature-public-collections": "workspace:*",
    "@frostbite/feature-public-products": "workspace:*",
    "@frostbite/game-admin": "workspace:*",
    "@frostbite/game-sdk": "workspace:*",
    "@frostbite/game-verification": "workspace:*",
    "@frostbite/http": "workspace:*",
    "@frostbite/object-storage": "workspace:*",
    "@frostbite/plugin-kit": "workspace:*",
    "@frostbite/scenes": "workspace:*",
    "@frostbite/share": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/configs": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@frostbite/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
