{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --experimental-strip-types src/main.ts",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts integration",
    "test:coverage": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts coverage"
  },
  "dependencies": {
    "@frostbite/database": "workspace:*",
    "@frostbite/feature-uploads": "workspace:*",
    "@frostbite/http": "workspace:*",
    "@frostbite/jobs": "workspace:*",
    "@frostbite/object-storage": "workspace:*",
    "@frostbite/plugin-kit": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "@repo/configs": "workspace:*"
  },
  "devDependencies": {
    "@frostbite/events": "workspace:*",
    "@frostbite/media": "workspace:*",
    "@frostbite/provider-workflows-inngest": "workspace:*",
    "@frostbite/test-kit": "workspace:*",
    "@frostbite/uploads": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
