{
  "template": "game-rewards",
  "version": "1.0.0",
  "family": "bitcoin-alkanes",
  "operations": [
    {
      "name": "initialize",
      "opcode": 0,
      "authority": "once",
      "inputs": ["collectible_template", "max_art_bytes"],
      "returns": "auth token"
    },
    {
      "name": "claim",
      "opcode": 1,
      "authority": "claimant",
      "inputs": ["milestone"],
      "returns": "collectible"
    },
    {
      "name": "define_milestone",
      "opcode": 2,
      "authority": "auth token",
      "inputs": ["milestone", "limit"],
      "witness": "optional svg drawing, uncompressed envelope"
    },
    { "name": "pause", "opcode": 3, "authority": "auth token", "inputs": [] },
    { "name": "resume", "opcode": 4, "authority": "auth token", "inputs": [] },
    {
      "name": "get_name",
      "opcode": 99,
      "view": true,
      "inputs": [],
      "returns": "string"
    },
    {
      "name": "get_claimed",
      "opcode": 100,
      "view": true,
      "inputs": ["holder_first_half", "holder_second_half", "milestone"],
      "returns": "u128"
    },
    {
      "name": "get_limit",
      "opcode": 101,
      "view": true,
      "inputs": ["milestone"],
      "returns": "u128"
    },
    {
      "name": "get_milestone_art",
      "opcode": 102,
      "view": true,
      "inputs": ["milestone"],
      "returns": "bytes"
    },
    {
      "name": "get_paused",
      "opcode": 103,
      "view": true,
      "inputs": [],
      "returns": "u128"
    }
  ]
}
