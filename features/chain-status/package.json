{
  "name": "@ador/feature-chain-status",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/registration.ts",
    "./api": "./src/client/api.ts",
    "./badge": "./src/ui/indexing-badge.tsx",
    "./fee-picker": "./src/ui/fee-picker-entry.ts",
    "./entrypoint": "./src/entrypoint.ts",
    "./operations": "./src/application/indexing.ts"
  },
  "scripts": {
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit --project unit-dom",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@ador/client-http": "workspace:*",
    "@ador/client-react": "workspace:*",
    "@ador/http": "workspace:*",
    "@ador/plugin-kit": "workspace:*",
    "@ador/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@ador/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
