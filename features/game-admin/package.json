{
  "name": "@ador/feature-game-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/registration.ts",
    "./entrypoint": "./src/entrypoint.tsx",
    "./operations": "./src/application/operations.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit --project unit-dom",
    "test:integration": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts integration",
    "test:coverage": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts coverage"
  },
  "dependencies": {
    "@ador/chain": "workspace:*",
    "@ador/client-http": "workspace:*",
    "@ador/database": "workspace:*",
    "@ador/feature-chain-status": "workspace:*",
    "@ador/game-admin": "workspace:*",
    "@ador/wallet": "workspace:*",
    "@ador/http": "workspace:*",
    "@ador/milestone-art": "workspace:*",
    "@ador/plugin-kit": "workspace:*",
    "@ador/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@ador/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
