{
  "name": "@frostbite/feature-games",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": "./src/registration.ts",
    "./catalog": "./src/domain/catalog.ts",
    "./claims-operations": "./src/application/claims-operations.ts",
    "./claims-runtime": "./src/claims-runtime.ts",
    "./entrypoint": "./src/entrypoint.tsx",
    "./game-cover": "./src/ui/game-cover.tsx",
    "./minted-art": "./src/ui/minted-art.tsx",
    "./runs-operations": "./src/application/runs-operations.ts",
    "./runs-runtime": "./src/runs-runtime.ts",
    "./runtime": "./src/runtime.ts",
    "./shared-view": "./src/domain/shared-view.ts",
    "./shares-operations": "./src/application/shares-operations.ts",
    "./shares-runtime": "./src/shares-runtime.ts",
    "./sync-operation": "./src/application/sync-operation.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@frostbite/chain": "workspace:*",
    "@frostbite/client-http": "workspace:*",
    "@frostbite/database": "workspace:*",
    "@frostbite/feature-chain-status": "workspace:*",
    "@frostbite/game-claims": "workspace:*",
    "@frostbite/game-runs": "workspace:*",
    "@frostbite/game-saves": "workspace:*",
    "@frostbite/game-sdk": "workspace:*",
    "@frostbite/game-shares": "workspace:*",
    "@frostbite/game-verification": "workspace:*",
    "@frostbite/http": "workspace:*",
    "@frostbite/plugin-kit": "workspace:*",
    "@frostbite/scenes": "workspace:*",
    "@frostbite/share": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "@frostbite/wallet": "workspace:*",
    "@repo/ui": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@frostbite/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/jsdom": "30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
