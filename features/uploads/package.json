{
  "name": "@ador/feature-uploads",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/registration.ts",
    "./bulk": "./src/ui/bulk-upload.tsx",
    "./cleanup": "./src/cleanup.ts",
    "./context": "./src/context.ts",
    "./entrypoint": "./src/entrypoint.tsx",
    "./inline": "./src/ui/inline-upload.tsx",
    "./pipeline": "./src/pipeline.ts",
    "./presentation": "./src/client/asset-presentation.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit --project unit-dom",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@ador/client-http": "workspace:*",
    "@ador/database": "workspace:*",
    "@ador/http": "workspace:*",
    "@ador/jobs": "workspace:*",
    "@ador/media": "workspace:*",
    "@ador/object-storage": "workspace:*",
    "@ador/plugin-kit": "workspace:*",
    "@ador/shared": "workspace:*",
    "@ador/uploads": "workspace:*",
    "@repo/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@ador/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
