{
  "name": "@frostbite/chain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./adapter": "./src/adapter.ts",
    "./alkanes": "./src/alkanes/runtime.ts",
    "./bitcoin": "./src/bitcoin/address.ts",
    "./bitcoin-alkanes": "./src/bitcoin-alkanes/adapter.ts",
    "./configured": "./src/configured.ts",
    "./indexing": "./src/indexing.ts",
    "./status-readings": "./src/status-readings.ts",
    "./ports": "./src/ports.ts",
    "./registry": "./src/registry.ts",
    "./wallet-signing": "./src/bitcoin-alkanes/wallet-signing.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:regtest": "vitest run --config vitest.regtest.config.ts"
  },
  "dependencies": {
    "@frostbite/cache": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "@alkanes/ts-sdk": "https://pkg.alkanes.build/dist/@alkanes/ts-sdk?v=0.1.6-669e7c0",
    "@bitcoinerlab/secp256k1": "1.2.0",
    "bitcoinjs-lib": "7.0.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "@repo/regtest": "workspace:*"
  }
}
