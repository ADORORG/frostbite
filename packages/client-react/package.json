{
  "name": "@frostbite/client-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@frostbite/client-http": "workspace:*",
    "@frostbite/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "^4.5.4"
  }
}
