{
  "name": "@repo/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env": "./src/env/runtime.ts",
    "./beta-network": "./src/env/beta-network.ts",
    "./mail": "./src/env/mail.ts",
    "./rewards-chain": "./src/env/rewards-chain.ts",
    "./authorization": "./src/policy/authorization.ts",
    "./email-code": "./src/policy/email-code.ts",
    "./setup-link": "./src/policy/setup-link.ts",
    "./transport": "./src/transport/loopback-transport.ts"
  },
  "scripts": {
    "env:check": "node --experimental-strip-types src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@ador/mail": "workspace:*",
    "@ador/shared": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
