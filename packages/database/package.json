{
  "name": "@ador/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection/index.ts",
    "./game-contracts": "./src/game-contracts/store.ts",
    "./outbox": "./src/outbox/repository.ts",
    "./rate-limit": "./src/rate-limit/postgres-limiter.ts",
    "./schema/accounts": "./src/schema/accounts.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/collection-submissions": "./src/schema/collection-submissions.ts",
    "./schema/collections": "./src/schema/collections.ts",
    "./schema/creator-admission": "./src/schema/creator-admission.ts",
    "./schema/derivatives": "./src/schema/derivatives.ts",
    "./schema/game-admin": "./src/schema/game-admin.ts",
    "./schema/game-claims": "./src/schema/game-claims.ts",
    "./schema/game-contracts": "./src/schema/game-contracts.ts",
    "./schema/game-runs": "./src/schema/game-runs.ts",
    "./schema/game-saves": "./src/schema/game-saves.ts",
    "./schema/platform": "./src/schema/platform.ts",
    "./schema/rate-limit": "./src/schema/rate-limit.ts",
    "./schema/uploads": "./src/schema/uploads.ts",
    "./schema/wallet-release": "./src/schema/wallet-release.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:check": "node --experimental-strip-types ../config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "migration:check": "node --experimental-strip-types test/support/check-migrations.ts",
    "migration:apply": "node --experimental-strip-types scripts/migrate.ts",
    "migration:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "node --experimental-strip-types test/support/run-postgres.ts integration",
    "test:coverage": "node --experimental-strip-types test/support/run-postgres.ts coverage"
  },
  "dependencies": {
    "@ador/events": "workspace:*",
    "@ador/jobs": "workspace:*",
    "@ador/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
