  "scripts": {
    "env:check": "node --experimental-strip-types ../config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "build:package": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/audio/panel.css','dist/audio/panel.css'); require('node:fs').cpSync('src/phone.css','dist/phone.css'); require('node:fs').cpSync('src/phone-frame.css','dist/phone-frame.css'); require('node:fs').cpSync('../../skills/build-a-game','dist/skill/files',{recursive:true})\"",
    "prepack": "pnpm run build:package"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "description": "Build a game that runs on the platform: the client for the game, the protocol, and the host side for testing it.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "bin": {
    "ador-game-dev": "./dist/dev-host/bin.js",
    "ador-game-skill": "./dist/skill/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
