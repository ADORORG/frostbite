{
  "name": "@ador/http",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/operation.ts",
    "./json-body": "./src/json-body.ts",
    "./present": "./src/present.ts",
    "./request-input": "./src/request-input.ts",
    "./cache": "./src/cache.ts",
    "./openapi": "./src/openapi.ts",
    "./outcome": "./src/outcome.ts",
    "./registered-operation": "./src/registered-operation.ts",
    "./node-adapter": "./src/node-adapter.ts",
    "./readiness": "./src/readiness.ts",
    "./rate-limit": "./src/rate-limit.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@ador/shared": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
