{
  "name": "@frostbite/plugin-kit",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": "./src/registry.ts",
    "./boot": "./src/boot.ts",
    "./lazy": "./src/lazy.ts",
    "./navigation": "./src/navigation.ts",
    "./page-metadata": "./src/page-metadata.ts",
    "./providers": "./src/provider-registry.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@frostbite/http": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
