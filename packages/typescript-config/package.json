{
  "name": "@repo/typescript-config",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/configs.unit.test.ts",
    "test:integration": "tsc --noEmit -p test/fixture/tsconfig.json",
    "test:coverage": "vitest run --coverage test/configs.unit.test.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
