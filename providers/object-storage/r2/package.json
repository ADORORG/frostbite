{
  "name": "@frostbite/provider-object-storage-r2",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": "./src/create-adapter.ts",
    "./config": "./src/config.ts",
    "./registration": "./src/registration.ts"
  },
  "scripts": {
    "env:check": "node --experimental-strip-types ../../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "node --experimental-strip-types test/support/run-s3.ts integration",
    "test:coverage": "node --experimental-strip-types test/support/run-s3.ts coverage",
    "smoke": "node --env-file-if-exists=../../../.env.local --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@frostbite/object-storage": "workspace:*",
    "@frostbite/plugin-kit": "workspace:*",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@repo/config": "workspace:*",
    "@smithy/protocol-http": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@frostbite/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
