{
  "name": "@frostbite/provider-workflows-inngest",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": "./src/create-endpoint.ts",
    "./config": "./src/config.ts",
    "./registration": "./src/registration.ts",
    "./provider-entrypoint": "./src/provider-entrypoint.ts"
  },
  "scripts": {
    "env:check": "node --experimental-strip-types ../../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@frostbite/events": "workspace:*",
    "@frostbite/jobs": "workspace:*",
    "@frostbite/plugin-kit": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "@repo/config": "workspace:*",
    "inngest": "4.21.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@frostbite/test-kit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
