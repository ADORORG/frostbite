{
  "name": "@repo/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "node --experimental-strip-types scripts/run-with-postgres.ts",
    "test:visual": "E2E_VISUAL=1 node --experimental-strip-types scripts/run-with-postgres.ts",
    "test:visual:update": "E2E_VISUAL=1 node --experimental-strip-types scripts/run-with-postgres.ts --update-snapshots=changed",
    "stack": "node --experimental-strip-types scripts/manual-stack.ts",
    "audit:game": "node --experimental-strip-types scripts/audit-game.ts",
    "stack:https": "node --experimental-strip-types scripts/stack-https.ts"
  },
  "devDependencies": {
    "@frostbite/auth": "workspace:*",
    "@frostbite/authorization": "workspace:*",
    "@frostbite/database": "workspace:*",
    "@frostbite/feature-accounts": "workspace:*",
    "@frostbite/game-sdk": "workspace:*",
    "@frostbite/mail": "workspace:*",
    "@frostbite/shared": "workspace:*",
    "@frostbite/test-kit": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@repo/configs": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "10.9.1",
    "vitest": "4.1.11"
  }
}
