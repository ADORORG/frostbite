{
  "name": "@repo/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "vitest run --config vitest.config.ts --project integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "node --experimental-strip-types scripts/run-with-postgres.ts",
    "stack": "node --experimental-strip-types scripts/manual-stack.ts",
    "audit:game": "node --experimental-strip-types scripts/audit-game.ts"
  },
  "devDependencies": {
    "@ador/auth": "workspace:*",
    "@ador/authorization": "workspace:*",
    "@ador/database": "workspace:*",
    "@ador/feature-accounts": "workspace:*",
    "@ador/game-sdk": "workspace:*",
    "@ador/mail": "workspace:*",
    "@ador/shared": "workspace:*",
    "@ador/test-kit": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "10.9.1",
    "vitest": "4.1.11"
  }
}
