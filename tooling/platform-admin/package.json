{
  "name": "@repo/platform-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env:check": "node --experimental-strip-types ../../packages/config/src/env/check-files.ts",
    "lint": "eslint . --max-warnings 0",
    "mailbox": "tsx src/mailbox-cli.ts",
    "setup-link": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:integration": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts integration",
    "test:coverage": "node --experimental-strip-types ../../packages/database/test/support/run-postgres.ts coverage"
  },
  "dependencies": {
    "@ador/authorization": "workspace:*",
    "@ador/database": "workspace:*",
    "@ador/feature-accounts": "workspace:*",
    "@ador/mail": "workspace:*",
    "@repo/config": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
