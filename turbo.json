{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["configs/**"],
  "globalEnv": [
    "CI",
    "APP_ENV",
    "AUTH_SESSION_IDLE_TIMEOUT_MS",
    "DATABASE_ACQUIRE_TIMEOUT_MS",
    "DATABASE_IDLE_TIMEOUT_MS",
    "DATABASE_POOL_MAX",
    "DATABASE_SSL_MODE",
    "DATABASE_STATEMENT_TIMEOUT_MS",
    "DATABASE_URL",
    "E2E_BASE_URL",
    "INNGEST_APP_ID",
    "INNGEST_BASE_URL",
    "INNGEST_DEV",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "NEXT_PUBLIC_APP_NAME",
    "PUBLIC_BASE_URL",
    "R2_ACCESS_KEY_ID",
    "R2_ENDPOINT",
    "R2_PRIVATE_BUCKET",
    "R2_PUBLIC_BUCKET",
    "R2_REGION",
    "R2_SECRET_ACCESS_KEY"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "env:check": {
      "dependsOn": ["^env:check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env*"]
    },
    "migration:check": {
      "dependsOn": ["^migration:check"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
