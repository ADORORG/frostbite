{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["configs/**"],
  "globalEnv": [
    "CI",
    "ALKANES_LIVE_NODE_URL",
    "APP_ENV",
    "AUTH_SESSION_ABSOLUTE_TIMEOUT_MS",
    "AUTH_SESSION_IDLE_TIMEOUT_MS",
    "DATABASE_ACQUIRE_TIMEOUT_MS",
    "DATABASE_IDLE_TIMEOUT_MS",
    "DATABASE_POOL_MAX",
    "DATABASE_SSL_MODE",
    "DATABASE_STATEMENT_TIMEOUT_MS",
    "DATABASE_URL",
    "E2E_BASE_URL",
    "E2E_VISUAL",
    "E2E_WORKERS",
    "INNGEST_APP_ID",
    "INNGEST_BASE_URL",
    "INNGEST_DEV",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "MAIL_CAPTURE_DIRECTORY",
    "MAIL_FROM_ADDRESS",
    "MAIL_SMTP_ENCRYPTION",
    "MAIL_SMTP_HOST",
    "MAIL_SMTP_PASSWORD",
    "MAIL_SMTP_PORT",
    "MAIL_SMTP_USER",
    "MAIL_TIMEOUT_MS",
    "MAIL_TRANSPORT",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_RUNTIME",
    "NODE_ENV",
    "PASSKEY_CHALLENGE_TIMEOUT_MS",
    "PASSKEY_RECENT_AUTH_WINDOW_MS",
    "PUBLIC_BASE_URL",
    "R2_ACCESS_KEY_ID",
    "R2_ENDPOINT",
    "R2_PRIVATE_BUCKET",
    "R2_PUBLIC_BUCKET",
    "R2_REGION",
    "R2_SECRET_ACCESS_KEY",
    "UPDATE_GAME_LAYOUT"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/games/**"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "public/play/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "env:check": {
      "dependsOn": ["^env:check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../.env*"]
    },
    "migration:check": {
      "dependsOn": ["^migration:check"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
